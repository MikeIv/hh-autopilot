# Локальная SQLite. Путь считается от prisma/schema.prisma, поэтому `../data`.
DATABASE_URL="file:../data/hh-autopilot.db"

# Портрет кандидата: YAML по схеме shared/schema/portrait.ts. Второй источник
# правды не заводим — берём своё резюме. Для публичного клона скопируйте
# data/resume.example.yaml в data/resume.yaml и оставьте путь по умолчанию.
# Относительный путь — от корня hh-autopilot, абсолютный — как есть.
# RESUME_PATH="data/resume.yaml"

# Профиль Playwright с сессией hh (в git не попадает). Логин выполняет человек:
# pnpm hh:login открывает видимое окно, пароль и коды из SMS вводит он сам.
HH_PROFILE_DIR=".dsh/hh-profile"

# Авто-отправка откликов. Выключено по умолчанию: без true прогон сухой.
# Включение — только вручную и на ограниченное время. «Отправить сейчас» в карточке
# работает и без этой переменной: это явное действие человека, но с лимитом и окном.
# HH_AUTO_APPLY="false"
