# Локальная SQLite. Путь считается от prisma/schema.prisma, поэтому `../data`.
DATABASE_URL="file:../data/hh-autopilot.db"

# Портрет кандидата. Второй источник правды не заводим: читаем data/resume.yaml
# соседнего пакета. Относительный путь — от корня hh-autopilot, абсолютный — как есть.
RESUME_PATH="../resume-site/data/resume.yaml"

# Профиль Playwright с сессией hh (в git не попадает). Сессию создаёт человек
# командой pnpm hh:login в resume-site: логин, пароль и коды из SMS знает только он.
HH_PROFILE_DIR="../resume-site/.dsh/hh-profile"

# Авто-отправка откликов. Включение — только вручную и на ограниченное время. Волна 7.
# HH_AUTO_APPLY="false"
