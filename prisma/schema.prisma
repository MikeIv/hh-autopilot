// Схема локальной базы hh-autopilot (SQLite).
// SQLite не умеет enum и Json: статусы — строки с union-типами в shared/types/domain.ts,
// структурированные поля (критерии оценки, статистика) — JSON-строки.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Вакансия из выдачи hh. Одна строка на hh_id — дедупликация на уровне схемы.
model Vacancy {
  id          String    @id @default(cuid())
  hhId        String    @unique
  title       String
  company     String
  url         String
  area        String?
  salaryFrom  Int?
  salaryTo    Int?
  currency    String?
  /// Режим работы и занятость в формулировках hh — нормализация в collector.
  schedule    String?
  employment  String?
  experience  String?
  description String?
  publishedAt DateTime?
  /// Поисковый запрос, которым вакансия найдена: по нему видно покрытие выдачи.
  source      String
  /// Отпечаток карточки: по нему видно, что работодатель правил вакансию.
  rawHash     String?
  collectedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  score       Score?
  letter      Letter?
  application Application?

  @@index([collectedAt])
  @@index([company])
}

/// Объяснимая оценка соответствия портрету: итог, порог и вклад каждого критерия.
model Score {
  id        String   @id @default(cuid())
  vacancyId String   @unique
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  total     Int
  threshold Int
  passed    Boolean
  /// JSON: [{ key, weight, earned, reason }]
  criteria  String
  scoredAt  DateTime @default(now())
}

/// Письмо под конкретную вакансию: вариант, текст и длина в символах поля hh.
model Letter {
  id         String    @id @default(cuid())
  vacancyId  String    @unique
  vacancy    Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  /// Вариант шаблона: product | outstaff | service
  variant    String
  body       String
  charCount  Int
  /// Когда человек выбрал вариант вручную: повторная генерация его не перетирает.
  selectedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  application Application?
}

/// Отклик. Отправка меняет статус; статусы — см. ApplicationStatus в shared/types/domain.ts.
model Application {
  id         String    @id @default(cuid())
  vacancyId  String    @unique
  vacancy    Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  letterId   String?   @unique
  letter     Letter?   @relation(fields: [letterId], references: [id])
  status     String    @default("queued")
  approvedAt DateTime?
  sentAt     DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Прогон инструмента: сбор, скоринг или отправка.
model Run {
  id         String    @id @default(cuid())
  kind       String
  status     String    @default("running")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// JSON: сколько найдено, новых, отсеяно по порогу.
  stats      String?
  note       String?

  actions ActionLog[]

  @@index([kind, startedAt])
}

/// Журнал действий и предохранителей: что инструмент сделал или почему остановился.
model ActionLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  kind    String
  level   String   @default("info")
  message String
  /// JSON с деталями события.
  meta    String?
  runId   String?
  run     Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([kind])
}

/// Настройки: порог отсечения, лимиты, окно времени, флаг авто-режима.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
